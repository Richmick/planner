<!DOCTYPE html>
<html lang="ru">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="theme-color" content="#17181c">
	<link rel="stylesheet" href="/common.css">
	<title>Планер дня</title>
</head>
<body>
	<header class="site-header">
		<div class="site-nav">
			<a class="brand" href="/">
				<span class="brand-mark" aria-hidden="true"></span>
				<span>Планер</span>
			</a>
			<nav class="site-links" aria-label="Основная навигация">
				<a href="/">Обзор</a>
				<a href="/calendar">Расписание</a>
			</nav>
			<a id="login-link" class="button button-subtle" href="/login">Войти</a>
			<form id="logout-form" hidden>
				<button class="button-subtle" type="submit">Выйти</button>
			</form>
		</div>
	</header>

	<main class="site-main">
		<p id="site-feedback" class="feedback error" role="alert" hidden></p>
		[[]]
	</main>

	<script src="/common.js"></script>
</body>
</html>
