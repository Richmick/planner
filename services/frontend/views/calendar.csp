<%layout views/main_layout.csp %>

<section class="calendar-page">
	<h1>Расписание</h1>

	<div class="calendar-columns">
		<div>
			<section class="calendar-section">
				<h2>Открыть календарь</h2>
				<form id="open-calendar-form" class="calendar-form">
					<div class="calendar-form-row">
						<label for="calendar-id">ID календаря</label>
						<input id="calendar-id" name="calendar_id" inputmode="numeric" pattern="[1-9][0-9]*" required>
						<button type="submit">Открыть</button>
					</div>
				</form>
				<p id="calendar-detail-status" role="status" hidden></p>
				<p id="calendar-detail-error" class="calendar-feedback error" role="alert" hidden></p>
				<article id="calendar-details" class="calendar-item" hidden></article>

				<form id="calendar-access-request" class="calendar-form" hidden>
					<div class="calendar-form-row">
						<label for="requested-access">Уровень доступа</label>
						<select id="requested-access" name="access">
							<option value="r">Чтение</option>
							<option value="w">Редактирование</option>
							<option value="s">Управление доступом</option>
						</select>
						<button type="submit">Запросить доступ</button>
					</div>
				</form>
				<p id="access-request-status" class="calendar-feedback" role="status" hidden></p>
			</section>

			<section class="calendar-section">
				<h2>Мои календари</h2>
				<form id="calendar-form" class="calendar-form">
					<label for="group-name">Учебная группа</label>
					<div class="calendar-form-row">
						<input id="group-name" name="group" type="text" placeholder="5130904/40101" required>
						<button type="submit">Добавить группу</button>
					</div>
				</form>
				<div id="calendar-list" class="calendar-list"></div>
			</section>

			<section class="calendar-section">
				<h2>Задачи по датам</h2>
				<form id="date-form" class="calendar-form">
					<div class="calendar-form-row">
						<label for="date-from">С</label>
						<input id="date-from" name="from" type="date" required>
						<label for="date-to">По</label>
						<input id="date-to" name="to" type="date" required>
						<button type="submit">Показать</button>
						<button id="active-events" type="button" class="secondary-button">Активные</button>
					</div>
				</form>
				<div id="calendar-error" class="calendar-feedback error" role="alert" hidden></div>
				<div id="event-list" class="event-list"></div>
			</section>
		</div>

		<aside class="calendar-notifications" aria-labelledby="notification-title">
			<h2 id="notification-title">Уведомления</h2>
			<p class="notification-note">Пример уведомлений</p>
			<ul class="notification-list" tabindex="0" aria-labelledby="notification-title">
				<li>
					<h3>Запрос на чтение</h3>
					<p>Пользователь №42 запрашивает доступ к календарю №102.</p>
					<form id="notification-grant" data-calendar-id="102" data-user-id="42" data-access="r">
						<button type="submit">Предоставить доступ</button>
					</form>
					<p id="grant-status" class="calendar-feedback" role="status" hidden></p>
				</li>
				<li>
					<h3>Запрос на редактирование</h3>
					<p>Пользователь №58 запрашивает доступ к календарю №109.</p>
				</li>
				<li>
					<h3>Доступ предоставлен</h3>
					<p>Пользователь №31 может читать календарь №101.</p>
				</li>
				<li>
					<h3>Доступ отозван</h3>
					<p>Пользователь №19 потерял доступ к календарю №106.</p>
				</li>
			</ul>
		</aside>
	</div>
</section>

<script src="/calendar.js"></script>
