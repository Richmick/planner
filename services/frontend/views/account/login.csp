<%inc
	#include <constants.hpp>
%>

<!DOCTYPE html>
<html lang="ru">

<%c++
	auto sessid = @@.get< std::string >("sessid");
%>

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<link rel="stylesheet" href="/common.css">
	<link rel="stylesheet" href="/account.css">
	<title>Вход · Планер</title>
	<script src="/account.js" defer></script>
</head>
<body class="auth-page">
	<div class="auth-header">
		<a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>Планер</a>
		<a id="backurl-link" class="auth-back" href="/"><span aria-hidden="true">←</span> Назад</a>
	</div>

	<main class="auth-main">
		<div class="auth-shell">
			<div class="auth-preview" aria-hidden="true">
				<div class="auth-board">
					<div class="auth-board-top"><i></i><i></i><i></i></div>
					<div class="auth-board-grid"><i></i><i></i><i></i><i></i><i></i></div>
				</div>
			</div>
			<section class="auth-content" aria-labelledby="auth-title">
				<h1 id="auth-title">Вход в аккаунт</h1>
				<form id="login-form" class="auth-form" action="/api/login" method="POST">
					<input type="hidden" name="sessid" value="<%c++   $$ << sessid;   %>">
					<label for="user-nickname">Логин</label>
					<input type="text" id="user-nickname" name="nickname" autocomplete="username" required>
					<label for="user-password">Пароль</label>
					<div class="auth-password">
						<input id="user-password" type="password" name="password" minlength="<%c++   $$ << api::pw_min_length;   %>" autocomplete="current-password" required>
						<button class="auth-toggle" type="button" aria-controls="user-password" aria-pressed="false">Показать</button>
					</div>
					<button class="auth-submit" type="submit">Войти</button>
				</form>
				<p id="error-place" class="auth-feedback" role="status" hidden></p>
				<p class="auth-switch">Нет аккаунта? <a href="/register" id="reg-link">Зарегистрироваться</a></p>
			</section>
		</div>
	</main>
</body>

</html>
