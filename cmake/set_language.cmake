include_guard()

macro (setup_cpp_std PLANNER_MODULE CXX_STD)
	string(TOUPPER ${PLANNER_MODULE} PLANNER_MODULE_U)
	if (NOT DEFINED PLANNER_CXX_STANDARD)
		if (NOT DEFINED CMAKE_CXX_STANDARD)
			set(PLANNER_${PLANNER_MODULE_U}_CXX_STANDARD ${CXX_STD})
		elseif (${CMAKE_CXX_STANDARD} LESS ${CXX_STD})
			message(WARNING "${PLANNER_MODULE}: C++${CXX_STD} required - use it over cmake global C++${CMAKE_CXX_STANDARD}")
			set(PLANNER_${PLANNER_MODULE_U}_CXX_STANDARD ${CXX_STD})
		else()
			set(PLANNER_${PLANNER_MODULE_U}_CXX_STANDARD ${CMAKE_CXX_STANDARD})
		endif()
	else()
		if (${PLANNER_CXX_STANDARD} LESS ${CXX_STD})
			message(STATUS "${PLANNER_MODULE}: C++${CXX_STD} required - use it over planner global C++${PLANNER_CXX_STANDARD}")
			set(PLANNER_${PLANNER_MODULE_U}_CXX_STANDARD ${CXX_STD})
		else()
			set(PLANNER_${PLANNER_MODULE_U}_CXX_STANDARD ${PLANNER_CXX_STANDARD})
		endif()
	endif()
	if (PLANNER_${PLANNER_MODULE_U}_CXX_STANDARD LESS ${CXX_STD})
		message(FATAL_ERROR "${PLANNER_MODULE}: at least C++${CXX_STD} is required")
	else()
		message(STATUS "${PLANNER_MODULE}: use C++${PLANNER_${PLANNER_MODULE_U}_CXX_STANDARD}")
	endif()
endmacro()
