{
	"listeners":
	[
		{
			"address": "0.0.0.0",
			"port": 443,
			"https": true,
			"cert": "./ssl/gateway.cert.pem",
			"key": "./ssl/gateway.key"
		}
	],
	"app":
	{
		"number_of_threads": 2,
		"enable_session": true,
		"session_timeout": 0,
		"session_same_site": "Strict",
		"session_cookie_key": "PLANNER-SESSID",
		"session_max_age": 600,
		"max_connections": 100000,
		"max_connections_per_ip": 0,
		"json_parser_stack_limit": 1000,
		"enable_unicode_escaping_in_json": false,
		"log":
		{
			"use_spdlog": false,
			//"log_path": "./", // commented = stdout
			"logfile_base_name": "planner_gateway",
			"log_size_limit": 100000000,
			"max_files": 0,
			"log_level": "DEBUG",
			"display_local_time": false
		},
		"run_as_daemon": false,
		"handle_sig_term": true,
		"relaunch_on_error": false,
		"use_sendfile": true,
		"use_gzip": true,
		"use_brotli": false,
		"idle_connection_timeout": 60,
		"server_header_field": "",
		"enable_server_header": true,
		"enable_date_header": true,
		"keepalive_requests": 0,
		"pipelining_requests": 0,
		"gzip_static": true,
		"br_static": true,
		"client_max_body_size": "1M",
		"client_max_memory_body_size": "64K",
		"client_max_websocket_message_size": "128K",
		"reuse_port": false,
		"enabled_compressed_request": false,
		"enable_request_stream": false
	},
	"plugins":
	[
		{
			"name": "drogon::plugin::AccessLogger",
			"dependencies": [],
			"config": {
				"use_spdlog": false,
				//"log_path": "",
				"log_format": "",
				"log_file": "access.log",
				"log_size_limit": 0,
				"use_local_time": true,
				"log_index": 0
			}
		},
		{
			"name": "api::gateway::proxy_plugin",
			"dependencies": [],
			"config":
			{
				"route": "static",
				"links":
				{
					"frontend":
					{
						"address": "http://127.0.0.1:5700",
						"same_client_to_same_backend": true,
						"connection_factor": 1
					},
					"users":
					{
						"address": "http://127.0.0.1:5701",
						"same_client_to_same_backend": true,
						"connection_factor": 1
					},
					"calendars":
					{
						"address": "http://127.0.0.1:5702",
						"same_client_to_same_backend": true,
						"connection_factor": 1
					},
					"scheduler":
					{
						"address": "http://127.0.0.1:5703",
						"same_client_to_same_backend": true,
						"connection_factor": 1,
						"healthcheck":
						{
							"timeout": 5
						}
					}
				}
			}
		}
	],
	"custom_config": {}
}
